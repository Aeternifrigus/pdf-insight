# Skopiuj do worker/.dev.vars (plik jest w .gitignore) i uzupełnij.
GEMINI_API_KEY=
# Lokalnie dopuszczamy serwer deweloperski i podgląd Vite (w produkcji tylko GitHub Pages).
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173
